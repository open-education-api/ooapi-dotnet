{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OEAPI.API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/OEAPI.API.dll",
      "cwd": "${workspaceFolder}/bin/Debug",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "stopAtEntry": false
    }
  ]
}
