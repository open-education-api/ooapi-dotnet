<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI 3.1 schemas are genuine JSON Schema draft 2020-12 - used to validate real response
         bodies against the spec's actual schemas, not just status codes. -->
    <PackageReference Include="JsonSchema.Net" Version="$(JsonSchemaNetVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="$(CoverletCollectorVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- For WebApplicationFactory-based integration tests -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftAspNetCoreMvcTestingVersion)" />
    <!-- Real, disposable SQL Server + PostgreSQL containers for integration tests - see the P6 note
         in docs/TODO-LIST.md on why this project deliberately doesn't use an in-memory/SQLite fake
         provider or the shared local dev databases. -->
    <PackageReference Include="Testcontainers.MsSql" Version="$(TestcontainersMsSqlVersion)" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="$(TestcontainersPostgreSqlVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OEAPI.API\OEAPI.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by scripts/extract-spec-manifest.py from the specification's published OpenAPI
         document - see SpecConformance/SpecManifest.cs for why this is embedded rather than parsed
         at test time. -->
    <EmbeddedResource Include="SpecConformance\spec-manifest.json" />
  </ItemGroup>

</Project>
