@startuml api-model
!theme plain
title OOAPI Reference Implementation - Public API Resource Model
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

note as N1
  Generated from src/OEAPI.Core/Models/ApiModels/*.cs. Shows identifying fields (id, primaryCode,
  name, the resource's own "type"/"state" discriminator where one exists) and the fields that
  define a relationship arrow - not a full property dump. Every relationship pictured is a spec
  "*Id" + expandable-object field pair (e.g. organisationId / organisation), unless noted
  otherwise. Regenerate via docs/diagrams/render.ps1 or render.sh after changing the source .cs
  files. See docs/archive/DECISIONS-AND-ACTIONS.md for the extensible-enum fields shown here as
  plain strings (organisationType, roomType, state, role, etc.) - all validated via
  [ExtensibleEnum], not C# enums. A symmetric parent/child self-reference (e.g. Organisation's
  parent/parentId + children/childIds) is drawn once, as a single arrow from the "parent"
  perspective - the inverse childIds/children field pair exists in code but isn't given its own
  arrow.
end note

package "Core / Organisational" {
  class Organisation <<resource>> {
    organisationId
    primaryCode : IdentifierEntry
    organisationType
    name
  }
  class Person <<resource>> {
    personId
    primaryCode : IdentifierEntry
    givenName / surname
    gender
  }
  class Group <<resource>> {
    groupId
    primaryCode : IdentifierEntry
    groupType
    name
  }
  class Membership <<resource>> {
    membershipId
    primaryCode : IdentifierEntry
    role
    state
  }
  class AcademicSession <<resource>> {
    academicSessionId
    primaryCode : IdentifierEntry
    academicSessionType
    name
  }
  class Building <<resource>> {
    buildingId
    primaryCode : IdentifierEntry
    name
  }
  class Room <<resource>> {
    roomId
    primaryCode : IdentifierEntry
    roomType
    name
  }
  class Address <<resource>> {
    primaryCode : IdentifierEntry
    addressType
    street / city / country
  }
}

package "Curriculum" {
  class Course <<resource>> {
    courseId
    primaryCode : IdentifierEntry
    name
    level
  }
  class Programme <<resource>> {
    programmeId
    primaryCode : IdentifierEntry
    programmeType
    name
  }
  class LearningComponent <<resource>> {
    componentId
    primaryCode : IdentifierEntry
    componentType
    name
  }
  class TestComponent <<resource>> {
    componentId
    primaryCode : IdentifierEntry
    componentType
    name
  }
  class LearningOutcome <<resource>> {
    learningOutcomeId
    primaryCode : IdentifierEntry
    name
    complexityLevel : LearningOutcomeLevel
  }
  class Document <<resource>> {
    documentId
    primaryCode : IdentifierEntry
    documentType
    documentName
  }
}

package "Offerings" {
  class CourseOffering <<resource>> {
    courseOfferingId
    primaryCode : IdentifierEntry
    name
    state / rosteringState
  }
  class ProgrammeOffering <<resource>> {
    programmeOfferingId
    primaryCode : IdentifierEntry
    name
    state / rosteringState
  }
  class LearningComponentOffering <<resource>> {
    learningComponentOfferingId
    primaryCode : IdentifierEntry
    name
    state / rosteringState
  }
  class TestComponentOffering <<resource>> {
    testComponentOfferingId
    primaryCode : IdentifierEntry
    name
    state / rosteringState
  }
}

package "Associations" {
  class CourseOfferingAssociation <<resource>> {
    courseOfferingAssociationId
    primaryCode : IdentifierEntry
    role
    state / remoteState
  }
  class ProgrammeOfferingAssociation <<resource>> {
    programmeOfferingAssociationId
    primaryCode : IdentifierEntry
    role
    state / remoteState
  }
  class LearningComponentOfferingAssociation <<resource>> {
    learningComponentOfferingAssociationId
    primaryCode : IdentifierEntry
    role
    state / remoteState / attendance
  }
  class TestComponentOfferingAssociation <<resource>> {
    testComponentOfferingAssociationId
    primaryCode : IdentifierEntry
    role
    state / remoteState / attendance
  }
  class TestComponentOfferingAssociationAttempt <<resource>> {
    attemptId
    opportunity / attempt
    state / attendance
  }
}

package "Supporting value objects" {
  class Result {
    state / pass
    score / rawScore
  }
  class Cost {
    costType
    amount / currency
  }
  class StudyLoadDescriptor {
    studyLoadUnit
    value
  }
}

package "Timeline Overrides" {
  class TimelineOverrideCourse {
    validFrom / validTo
    course : CourseProperties
  }
  class TimelineOverrideProgramme {
    validFrom / validTo
    programme : ProgrammeProperties
  }
}

note bottom of TimelineOverrideProgramme
  CourseProperties/ProgrammeProperties mirror every field Course/Programme
  themselves expose (minus the id and validFrom/validTo fields) - a full,
  independent alternate snapshot, not a diff against the parent resource.
end note

