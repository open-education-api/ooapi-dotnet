{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStrings": {
      "SqlServer": "Server=(localdb)\\mssqllocaldb;Database=OEAPIDatabase;Trusted_Connection=True;MultipleActiveResultSets=true",
      "PostgreSQL": "Host=localhost;Port=5432;Database=OEAPIDatabase;Username=youruser;Password=yourpassword"
    },
    "SeedDemoData": false
  },
  "Authentication": {
    "Providers": {
      "JwtEnabled": false,
      "ApiKeyEnabled": false,
      "CustomEnabled": false
    },
    "RequireAuthentication": false,
    "AllowAnonymousAccess": true,
    "Jwt": {
      "Issuer": "",
      "Audience": "",
      "SecretKey": "",
      "ValidateSignature": true,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ClockSkewSeconds": 300
    },
    "ApiKey": {
      "HeaderName": "X-API-Key",
      "UseAuthorizationHeader": false,
      "HeaderPrefix": "",
      "EnableCaching": true,
      "CacheDurationMinutes": 60
    }
  },
  "Service": {
    "ContactEmail": "admin@example-education-institution.nl",
    "Specification": "https://raw.githubusercontent.com/open-education-api/specification/release/6.0/oeapi.yaml",
    "Documentation": "https://oeapi.eu/",
    "SupportedOeapiVersions": [ "6.0" ],
    "ExposeNonCanonicalListEndpoints": false,
    "SupportedConsumers": [
      {
        "ConsumerKey": "nl-edusites",
        "Version": "1.0"
      }
    ],
    "ExtJson": "{\"x-demo-note\":\"Example institution-specific field, for local conformance testing.\"}",
    "SupportedExpands": [
      {
        "ExpandableObjects": [
          "parent",
          "children",
          "year"
        ],
        "Path": "/academic-sessions"
      },
      {
        "ExpandableObjects": [
          "academic_session",
          "course_offering",
          "person"
        ],
        "Path": "/course-offering-associations"
      },
      {
        "ExpandableObjects": [
          "course",
          "programme_offering",
          "academic_session"
        ],
        "Path": "/course-offerings"
      },
      {
        "ExpandableObjects": [
          "programmes",
          "coordinators",
          "instructors",
          "organisation",
          "learning_outcomes"
        ],
        "Path": "/courses"
      },
      {
        "ExpandableObjects": [
          "organisation",
          "academic_session"
        ],
        "Path": "/groups"
      },
      {
        "ExpandableObjects": [
          "person",
