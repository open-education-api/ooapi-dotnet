<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftEntityFrameworkCoreVersion)"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftEntityFrameworkCoreSqlServerVersion)"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEntityFrameworkCorePostgreSQLVersion)"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftEntityFrameworkCoreVersion)">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsConfigurationVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsConfigurationJsonVersion)"/>
        <!-- Pinned to override the vulnerable 9.0.0 transitively pulled in by Microsoft.EntityFrameworkCore.Design -> Microsoft.Build.Tasks.Core (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf) -->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="$(SystemSecurityCryptographyXmlVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OEAPI.Core\OEAPI.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Generated by scripts/extract-spec-manifest.py from the specification's published OpenAPI
             document - see Query/Fields/SpecFieldRequirements.cs for why this is embedded here. -->
        <EmbeddedResource Include="Query\Fields\field-requirements.json"/>
    </ItemGroup>

</Project>
